# Arquivo .env - Configurações de Ambiente

# Cole aqui a URL do seu projeto Supabase
SUPABASE_URL="YOUR_SUPABASE_URL"

# Cole aqui a Chave Anônima (public) do seu projeto Supabase
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# (Opcional/Futuro) Chave de Serviço (secret) - Use com cuidado no backend
# SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_KEY"

# Porta para o servidor backend
PORT=3000



# Stripe API Keys (Replace with your actual keys)
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY" # Keep this secret!
STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"

# Stripe Webhook Secret (for verifying webhook events)
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# Platform Commission Percentage (e.g., 10 for 10%)
PLATFORM_COMMISSION_PERCENTAGE=10

